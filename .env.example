# Copier en .env (jamais commité) ou poser ces variables dans Railway.
# Aucune valeur réelle ici.

# --- Post For Me -------------------------------------------------------------
POST_FOR_ME_API_KEY=
# 1 si la clé est injectée par un proxy (API credential Claude Code) au lieu d'être lue ici
PFM_AUTH_VIA_PROXY=0
# Pour les liens « à vérifier dans Post For Me » : app.postforme.dev/<équipe>/<projet>/posts/<id>
PFM_TEAM_ID=
PFM_PROJECT_ID=
# Identifiants des comptes connectés (spc_…) : `python scripts/publish.py accounts`
PFM_ACCOUNT_FACEBOOK=
PFM_ACCOUNT_INSTAGRAM=
PFM_ACCOUNT_YOUTUBE=
PFM_ACCOUNT_TIKTOK=
PFM_ACCOUNT_LINKEDIN=
PFM_ACCOUNT_X=

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=dl8itl9nw
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=udr-publish
# sha1 (défaut Cloudinary) ou sha256 selon le réglage du compte
CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# --- Garde-fous ----------------------------------------------------------------
# 0 : tout pack en mode live est refusé. Passer à 1 uniquement pour la production.
PUBLISH_ALLOW_LIVE=0
# Délai minimal entre le dépôt et la date de publication, en minutes
PUBLISH_MIN_LEAD_MINUTES=5

# --- Stockage et service -----------------------------------------------------
# Journal JSONL + verrous (Railway : chemin du volume, ex. /data)
PUBLISH_DATA_DIR=./data
# Secret partagé avec n8n (en-tête Authorization: Bearer …) ; ex. `openssl rand -hex 32`
PUBLISH_SERVICE_TOKEN=
# Mot de passe de la page de dépôt https://<domaine>/depot (12 caractères minimum).
# Vide : la page est désactivée, seul n8n peut déposer.
PUBLISH_PAGE_PASSWORD=
